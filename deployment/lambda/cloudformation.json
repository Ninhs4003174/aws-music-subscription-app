{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWS Music Subscription App - Lambda + API Gateway Backend",
  "Resources": {
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "DynamoDBAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Resource": "arn:aws:dynamodb:us-east-1:*:table/*"
                }
              ]
            }
          },
          {
            "PolicyName": "S3Access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": "arn:aws:s3:::*"
                }
              ]
            }
          }
        ]
      }
    },
    "MusicAppLambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "music-subscription-app",
        "Runtime": "python3.10",
        "Role": {
          "Fn::GetAtt": ["LambdaExecutionRole", "Arn"]
        },
        "Handler": "lambda_handler.handler",
        "Timeout": 30,
        "MemorySize": 512,
        "Code": {
          "ZipFile": "import sys; sys.path.insert(0, '/var/task')"
        },
        "Environment": {
          "Variables": {
            "AWS_REGION": "us-east-1"
          }
        }
      }
    },
    "MusicAppAPI": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": "music-subscription-app",
        "Description": "Music Subscription Web Application API",
        "EndpointConfiguration": {
          "Types": ["REGIONAL"]
        }
      }
    },
    "APIDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "StageName": "prod"
      },
      "DependsOn": ["ProxyMethod", "ProxyOptions", "RootMethod", "RootOptions"]
    },
    "ProxyResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "ParentId": {
          "Fn::GetAtt": ["MusicAppAPI", "RootResourceId"]
        },
        "PathPart": "{proxy+}"
      }
    },
    "ProxyMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "ResourceId": {
          "Ref": "ProxyResource"
        },
        "HttpMethod": "ANY",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "aws_proxy",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${MusicAppLambda.Arn}/invocations"
          }
        }
      }
    },
    "ProxyOptions": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "ResourceId": {
          "Ref": "ProxyResource"
        },
        "HttpMethod": "OPTIONS",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "MOCK",
          "IntegrationResponses": [
            {
              "StatusCode": "200",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'",
                "method.response.header.Access-Control-Allow-Methods": "'GET,POST,PUT,DELETE,OPTIONS'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              }
            }
          ]
        },
        "MethodResponses": [
          {
            "StatusCode": "200",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Headers": true,
              "method.response.header.Access-Control-Allow-Methods": true,
              "method.response.header.Access-Control-Allow-Origin": true
            }
          }
        ]
      }
    },
    "RootMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "ResourceId": {
          "Fn::GetAtt": ["MusicAppAPI", "RootResourceId"]
        },
        "HttpMethod": "ANY",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "aws_proxy",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${MusicAppLambda.Arn}/invocations"
          }
        }
      }
    },
    "RootOptions": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "MusicAppAPI"
        },
        "ResourceId": {
          "Fn::GetAtt": ["MusicAppAPI", "RootResourceId"]
        },
        "HttpMethod": "OPTIONS",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "MOCK",
          "IntegrationResponses": [
            {
              "StatusCode": "200",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'",
                "method.response.header.Access-Control-Allow-Methods": "'GET,POST,PUT,DELETE,OPTIONS'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              }
            }
          ]
        },
        "MethodResponses": [
          {
            "StatusCode": "200",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Headers": true,
              "method.response.header.Access-Control-Allow-Methods": true,
              "method.response.header.Access-Control-Allow-Origin": true
            }
          }
        ]
      }
    },
    "LambdaInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "MusicAppLambda"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${MusicAppAPI}/*/*"
        }
      }
    }
  },
  "Outputs": {
    "APIEndpoint": {
      "Description": "API Gateway Endpoint URL",
      "Value": {
        "Fn::Sub": "https://${MusicAppAPI}.execute-api.${AWS::Region}.amazonaws.com/prod"
      }
    },
    "LambdaFunctionArn": {
      "Description": "Lambda Function ARN",
      "Value": {
        "Fn::GetAtt": ["MusicAppLambda", "Arn"]
      }
    }
  }
}
